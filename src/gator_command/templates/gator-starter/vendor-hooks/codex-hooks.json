{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .gator/.includes/scripts/gator-session-open.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python .gator/.includes/scripts/gator-session-start.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
